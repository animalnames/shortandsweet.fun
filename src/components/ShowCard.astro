---
import { toLocalShowDate } from '../lib/showDate';

interface Props {
  date: string | Date;
  time: string;
  name?: string;
  venue: string;
  location: string;
  url?: string;
  past?: boolean;
}

const { date, time, name, venue, location, url, past = false } = Astro.props;

const formatted = toLocalShowDate(date).toLocaleDateString('en-US', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<div class:list={['show-card', { 'show-card-past': past }]}>
  <div class="show-card-date">
    <span class="show-day">{formatted}</span>
    <span class="show-time">{time}</span>
  </div>
  <div class="show-card-details">
    {name ? (
      <>
        <h3 class="show-name">{name}</h3>
        <p class="show-venue">{venue}</p>
      </>
    ) : (
      <h3 class="show-name">{venue}</h3>
    )}
    <p class="show-location">{location}</p>
    {url && (
      <a href={url} target="_blank" rel="noopener noreferrer" class="show-link">
        {past ? 'Info' : 'Tickets & Info'} &rarr;
      </a>
    )}
  </div>
</div>

<style>
  .show-card {
    display: flex;
    flex-direction: column;
    border: 2px solid var(--color-accent);
    border-left: 6px dashed var(--color-accent);
    border-radius: 0 8px 8px 0;
    padding: 1.25rem 1.5rem;
    transform: rotate(-0.5deg);
    background: white;
    box-shadow: 3px 3px 0 var(--color-accent-yellow);
    transition: transform 0.2s;
  }

  .show-card-past {
    opacity: 0.75;
    box-shadow: none;
    border-color: color-mix(in srgb, var(--color-accent) 55%, transparent);
  }

  .show-card:hover {
    transform: rotate(0deg) translateY(-2px);
  }

  .show-card-date {
    font-family: var(--font-display);
    margin-bottom: 0.5rem;
  }

  .show-day {
    font-size: 1.1rem;
    color: var(--color-accent);
    display: block;
  }

  .show-time {
    font-size: 0.9rem;
    color: var(--color-text);
    opacity: 0.7;
  }

  .show-name {
    font-family: var(--font-body);
    font-size: 1.15rem;
    font-weight: 700;
  }

  .show-venue {
    font-size: 0.95rem;
    margin-top: 0.15rem;
  }

  .show-location {
    font-size: 0.95rem;
    opacity: 0.7;
    margin-top: 0.15rem;
  }

  .show-link {
    display: inline-block;
    margin-top: 0.5rem;
    font-weight: 700;
    font-size: 0.95rem;
  }

  @media (min-width: 768px) {
    .show-card {
      flex-direction: row;
      align-items: center;
      gap: 2rem;
    }

    .show-card-date {
      margin-bottom: 0;
      min-width: 200px;
    }
  }
</style>
